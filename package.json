{
  "name": "meubolso",
  "version": "2.1.0",
  "description": "MeuBolso — gerenciador de finanças pessoais minimalista para dívidas, empréstimos e cartão de crédito (desktop, 100% local)",
  "main": "main.js",
  "author": "Marcelo Acácio <dev@meubolso.app>",
  "license": "MIT",
  "homepage": "https://github.com/marceloacaci/meubolso#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/marceloacaci/meubolso.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.meubolso.app",
    "productName": "MeuBolso",
    "copyright": "Copyright © 2026 MeuBolso",
    "icon": "build/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "marceloacaci",
      "repo": "meubolso"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{test,tests,doc,docs,example,examples,benchmark,benchmarks}",
      "!**/*.map",
      "!**/{.git,.github,tests,test,coverage,docs}"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        },
        {
          "target": "deb",
          "arch": "x64"
        }
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-linux.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "x64"
        },
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-mac.${ext}"
    }
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "onlyBuiltDependencies": [
    "7zip-bin",
    "@electron/rebuild",
    "core-js",
    "app-builder-bin",
    "node-gyp"
  ]
}
